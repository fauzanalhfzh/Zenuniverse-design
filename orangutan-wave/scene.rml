            <Stroke thickness="8" name="Stroke"><SolidColor colorValue="FFF5822A" name="C"/></Stroke>
        </Shape>

        <!-- Laptop with </> -->
        <Node x="258" y="428" rotation="-0.1" name="Laptop">
            <Shape name="Code">
                <PointsPath isClosed="false" name="Path">
                    <StraightVertex x="-24" y="-13"/>
                    <StraightVertex x="-38" y="0"/>
                    <StraightVertex x="-24" y="13"/>
                </PointsPath>
                <PointsPath isClosed="false" name="Path">
                    <StraightVertex x="7" y="-18"/>
                    <StraightVertex x="-7" y="18"/>
                </PointsPath>
                <PointsPath isClosed="false" name="Path">
                    <StraightVertex x="24" y="-13"/>
                    <StraightVertex x="38" y="0"/>
                    <StraightVertex x="24" y="13"/>
                </PointsPath>
                <Stroke thickness="7" cap="round" join="round" name="Stroke">
                    <SolidColor colorValue="FFFFFFFF" name="C"/>
                </Stroke>
            </Shape>
            <Shape name="Lid">
                <Rectangle width="150" height="102" cornerRadiusTL="12" name="Path"/>
                <Fill name="Fill"><SolidColor colorValue="FF2B2862" name="C"/></Fill>
                <Stroke thickness="4" name="Stroke"><SolidColor colorValue="FF46439A" name="C"/></Stroke>
            </Shape>
        </Node>

        <!-- Left arm resting on the laptop -->
        <Shape x="196" y="452" name="Glove L">
            <Ellipse width="50" height="42" name="Path"/>
            <Fill name="Fill"><SolidColor colorValue="FFFFFFFF" name="C"/></Fill>
            <Stroke thickness="5" name="Stroke"><SolidColor colorValue="FF2B2862" name="C"/></Stroke>
        </Shape>
        <Shape x="178" y="420" rotation="-0.55" name="Cuff L">
            <Rectangle width="52" height="14" cornerRadiusTL="7" name="Path"/>
            <Fill name="Fill"><SolidColor colorValue="FFF5822A" name="C"/></Fill>
        </Shape>
        <Shape x="166" y="398" rotation="-0.55" name="Sleeve L">
