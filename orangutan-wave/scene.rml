                <Shape x="47" y="22" opacity="0.75" name="Cheek R">
                    <Ellipse width="24" height="15" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FFF4917A" name="C"/></Fill>
                </Shape>
                <Shape x="0" y="0" name="Face Skin">
                    <Ellipse y="16" width="124" height="104" name="Path"/>
                    <Ellipse x="-27" y="-6" width="64" height="60" name="Path"/>
                    <Ellipse x="27" y="-6" width="64" height="60" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FFF9C08C" name="C"/></Fill>
