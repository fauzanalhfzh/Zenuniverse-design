            <Fill name="Fill"><SolidColor colorValue="FFFFFFFF" name="C"/></Fill>
            <Stroke thickness="4" name="Stroke"><SolidColor colorValue="FFE4E3F3" name="C"/></Stroke>
        </Shape>

        <!-- Legs -->
        <Shape x="176" y="500" rotation="0.15" name="Boot L">
            <Ellipse width="62" height="74" name="Path"/>
            <Fill name="Fill"><SolidColor colorValue="FF2B2862" name="C"/></Fill>
        </Shape>
        <Shape x="336" y="500" rotation="-0.15" name="Boot R">
            <Ellipse width="62" height="74" name="Path"/>
            <Fill name="Fill"><SolidColor colorValue="FF2B2862" name="C"/></Fill>
        </Shape>
        <Shape x="206" y="478" name="Leg Band L">
            <Rectangle width="14" height="56" cornerRadiusTL="7" name="Path"/>
            <Fill name="Fill"><SolidColor colorValue="FFF5822A" name="C"/></Fill>
