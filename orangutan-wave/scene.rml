<Rive version="1" kind="fragment">
    <!-- Orangutan astronaut waving hello. Siblings draw first-declared-on-top. -->
    <Artboard defaultStateMachineId="0:7" styleId="0:5" width="500" height="540" name="Orangutan" id="0:2">
        <LayoutComponentStyle name="Artboard Style" id="0:5"/>

        <Fill name="Background">
            <SolidColor colorValue="FFF8F8FC" name="Color"/>
        </Fill>

        <!-- Sparks next to the waving hand -->
        <Node x="438" y="140" name="Sparks" id="0:20">
