            <Fill name="Fill"><SolidColor colorValue="FFFFFFFF" name="C"/></Fill>
            <Stroke thickness="4" name="Stroke"><SolidColor colorValue="FFE4E3F3" name="C"/></Stroke>
        </Shape>

        <Shape x="168" y="380" name="Backpack">
            <Rectangle width="80" height="150" cornerRadiusTL="34" name="Path"/>
            <Fill name="Fill"><SolidColor colorValue="FF2B2862" name="C"/></Fill>
        </Shape>

        <!-- Each layer plays one looping timeline -->
        <StateMachine name="State Machine 1" id="0:7">
            <StateMachineLayer name="Wave" id="0:8">
                <AnyState x="200" y="-120"/>
                <ExitState x="400" y="-120"/>
                <EntryState>
                    <StateTransition stateToId="0:12"/>
                </EntryState>
                <AnimationState x="200" animationId="0:6" id="0:12"/>
            </StateMachineLayer>
            <StateMachineLayer name="Blink" id="0:9">
                <AnyState x="200" y="-120"/>
                <ExitState x="400" y="-120"/>
                <EntryState>
                    <StateTransition stateToId="0:13"/>
                </EntryState>
                <AnimationState x="200" animationId="0:60" id="0:13"/>
            </StateMachineLayer>
            <StateMachineLayer name="Sparks" id="0:10">
                <AnyState x="200" y="-120"/>
                <ExitState x="400" y="-120"/>
                <EntryState>
                    <StateTransition stateToId="0:14"/>
                </EntryState>
                <AnimationState x="200" animationId="0:70" id="0:14"/>
            </StateMachineLayer>
        </StateMachine>

        <!-- Two waves per 1.6s loop; hand lags the arm, head bobs along -->
        <LinearAnimation loopValue="loop" duration="96" name="Wave" id="0:6">
            <KeyedObject objectId="0:50">
                <KeyedProperty property="rotation">
                    <KeyFrameDouble frame="0" value="0.5" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble frame="24" value="0.88" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble frame="48" value="0.5" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble frame="72" value="0.88" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble frame="96" value="0.5" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:51">
                <KeyedProperty property="rotation">
                    <KeyFrameDouble frame="0" value="0.3" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble frame="28" value="-0.35" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble frame="52" value="0.3" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble frame="76" value="-0.35" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble frame="96" value="0.3" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:30">
                <KeyedProperty property="rotation">
                    <KeyFrameDouble frame="0" value="-0.03" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble frame="48" value="0.05" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble frame="96" value="-0.03" interpolationType="linear"/>
                </KeyedProperty>
                <KeyedProperty property="y">
                    <KeyFrameDouble frame="0" value="330" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble frame="24" value="325" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble frame="48" value="330" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble frame="72" value="325" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble frame="96" value="330" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- Quick blink once every 3s -->
        <LinearAnimation loopValue="loop" duration="180" name="Blink" id="0:60">
            <KeyedObject objectId="0:41">
                <KeyedProperty property="scaleY">
                    <KeyFrameDouble frame="0" value="1" interpolationType="hold"/>
                    <KeyFrameDouble frame="150" value="1" interpolationType="linear"/>
                    <KeyFrameDouble frame="155" value="0.1" interpolationType="linear"/>
                    <KeyFrameDouble frame="161" value="1" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:42">
                <KeyedProperty property="scaleY">
                    <KeyFrameDouble frame="0" value="1" interpolationType="hold"/>
                    <KeyFrameDouble frame="150" value="1" interpolationType="linear"/>
                    <KeyFrameDouble frame="155" value="0.1" interpolationType="linear"/>
                    <KeyFrameDouble frame="161" value="1" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- Sparks pop at each wave peak -->
        <LinearAnimation loopValue="loop" duration="48" name="Sparks" id="0:70">
            <KeyedObject objectId="0:20">
                <KeyedProperty property="scaleX">
                    <KeyFrameDouble frame="0" value="0.6" interpolationType="cubic"><CubicEaseInterpolator x1="0.34" y1="1.56" x2="0.64" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble frame="24" value="1.1" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble frame="48" value="0.6" interpolationType="linear"/>
                </KeyedProperty>
                <KeyedProperty property="scaleY">
                    <KeyFrameDouble frame="0" value="0.6" interpolationType="cubic"><CubicEaseInterpolator x1="0.34" y1="1.56" x2="0.64" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble frame="24" value="1.1" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble frame="48" value="0.6" interpolationType="linear"/>
                </KeyedProperty>
                <KeyedProperty property="opacity">
                    <KeyFrameDouble frame="0" value="0.25" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble frame="20" value="1" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble frame="48" value="0.25" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
    </Artboard>
</Rive>
