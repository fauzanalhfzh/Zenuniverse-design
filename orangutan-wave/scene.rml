            </Node>

            <Shape x="-48" y="-178" rotation="-0.6" opacity="0.35" name="Visor Shine">
                <Ellipse width="34" height="12" name="Path"/>
                <Fill name="Fill"><SolidColor colorValue="FF8F8BD6" name="C"/></Fill>
            </Shape>
            <Shape x="0" y="-112" name="Visor">
