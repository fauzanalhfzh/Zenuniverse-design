                        <StraightVertex x="-26" y="8"/>
                        <CubicDetachedVertex x="-6" y="-18" inRotation="2.4" inDistance="10" outRotation="-0.6" outDistance="8"/>
                        <CubicDetachedVertex x="6" y="-6" inRotation="-2.2" inDistance="6" outRotation="-0.9" outDistance="10"/>
                        <CubicDetachedVertex x="22" y="-14" inRotation="-2.6" inDistance="8" outRotation="1.6" outDistance="10"/>
                        <StraightVertex x="26" y="8"/>
                    </PointsPath>
                    <Fill name="Fill"><SolidColor colorValue="FFE8712B" name="C"/></Fill>
                </Shape>
                <Shape x="-84" y="10" name="Ear L Inner">
                    <Ellipse width="17" height="22" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FFF9C08C" name="C"/></Fill>
                </Shape>
                <Shape x="-84" y="10" name="Ear L">
